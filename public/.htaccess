# ======================================================
# Trimitha - Apache .htaccess Configuration
# Purpose: Single 301 redirect to canonical URL
# Final Destination: https://www.trimitha.co.in/
# ======================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # ==================================================
    # REDIRECT TO HTTPS + WWW (Single 301 Redirect)
    # ==================================================
    
    # Step 1: Redirect HTTP to HTTPS (non-WWW or WWW)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} ^(www\.)?trimitha\.co\.in$ [NC]
    RewriteRule ^(.*)$ https://www.trimitha.co.in/$1 [R=301,L]
    
    # Step 2: Redirect non-WWW HTTPS to WWW HTTPS
    RewriteCond %{HTTP_HOST} ^trimitha\.co\.in$ [NC]
    RewriteRule ^(.*)$ https://www.trimitha.co.in/$1 [R=301,L]
    
    # ==================================================
    # REMOVE TRAILING SLASH FOR NON-DIRECTORY URLs
    # ==================================================
    
    # Remove trailing slash for non-directory files
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [R=301,L]
    
    # ==================================================
    # REMOVE INDEX.HTML FROM URLS
    # ==================================================
    
    # Redirect index.html to root or directory path
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^?]*)(index\.html?)?(\?.*)?\ HTTP/
    RewriteRule ^(.*)(index\.html?)$ /$1 [R=301,L]
    
    # Redirect /index to root
    RewriteRule ^index\.html?$ / [R=301,L]
    
    # ==================================================
    # HANDLE .html EXTENSION REDIRECTS
    # ==================================================
    
    # Redirect .html pages to extensionless URLs
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.*?)/?$ /$1.html [L]
    
    # Redirect requests for .html to extensionless (SEO)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.html\ HTTP
    RewriteRule ^([^.]+)\.html$ /$1 [R=301,L]
    
    # ==================================================
    # CUSTOM PAGES (if .html files exist)
    # ==================================================
    
    # If the requested file doesn't exist, check for .html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.*)$ /$1.html [L]
    
</IfModule>

# ======================================================
# SECURITY HEADERS
# ======================================================

<IfModule mod_headers.c>
    # Force HTTPS
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # XSS Protection
    Header always set X-XSS-Protection "1; mode=block"
    
    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Content Security Policy (adjust as needed)
    Header always set Content-Security-Policy "upgrade-insecure-requests"
</IfModule>

# ======================================================
# CACHE CONTROL
# ======================================================

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType text/javascript "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# ======================================================
# COMPRESSION
# ======================================================

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json
</IfModule>

# ======================================================
# ERROR DOCUMENTS
# ======================================================

ErrorDocument 404 /404.html
ErrorDocument 500 /500.html
